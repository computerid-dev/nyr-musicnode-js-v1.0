{
  "name": "nyr-musicnode-js-v1",
  "version": "1.0.0",
  "private": true,
  "description": "NYR Music Node: website musik berbasis kode Node.js jiosaavn-api (tidak resmi)",
  "license": "MIT",
  "engines": { "node": "26.x" },
  "scripts": {
    "build:backend": "esbuild musicnode/backend/src/server.ts --bundle --platform=node --target=node20 --format=cjs --tsconfig=musicnode/backend/tsconfig.json --outfile=musicnode/backend/dist/server.cjs",
    "build:static": "node scripts/build-static.mjs",
    "build": "npm run build:backend && npm run build:static",
    "start": "node musicnode/backend/dev-server.js",
    "dev": "npm run build && npm start",
    "typecheck": "tsc -p musicnode/backend/tsconfig.json"
  },
  "dependencies": {
    "@hono/zod-openapi": "^0.19.2",
    "@hono/zod-validator": "^0.4.3",
    "@scalar/hono-api-reference": "^0.7.4",
    "hono": "^4.7.5",
    "node-forge": "^1.3.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@types/node-forge": "^1.3.11",
    "esbuild": "^0.25.0",
    "typescript": "^5.8.2"
  }
}
